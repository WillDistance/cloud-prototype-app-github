    {"name":"4. login","event":[{"listen":"test","script":{"exec":["const body = pm.response.json();","if (body.data && body.data.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\"\n}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/api/auth/login"},"response":[]},
    {"name":"5. sendResetPasswordCode","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{email}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/api/auth/sendResetPasswordCode"},"response":[]},
    {"name":"6. verifyResetPasswordCode","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{code}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/api/auth/verifyResetPasswordCode"},"response":[]},
    {"name":"7. resetPassword","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{email}}\",\n  \"newPassword\": \"newPassword123\",\n  \"confirmPassword\": \"newPassword123\"\n}","options":{"raw":{"language":"json"}}},"url":"{{baseUrl}}/api/auth/resetPassword"},"response":[]},
