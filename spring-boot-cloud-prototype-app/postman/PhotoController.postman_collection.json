{
  "info": {
    "name": "PhotoController",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/app"
    },
    {
      "key": "accessToken",
      "value": "[REDACTED]"
    },
    {
      "key": "photoFileId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "listPhotos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/photo/listPhotos?range=TODAY&size=20"
      },
      "response": []
    },
    {
      "name": "getPhotoDetail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/photo/getPhotoDetail?photoFileId={{photoFileId}}"
      },
      "response": []
    },
    {
      "name": "getOriginalDownloadUrl",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/photo/getOriginalDownloadUrl?photoFileId={{photoFileId}}"
      },
      "response": []
    },
    {
      "name": "deletePhotos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"photoFileIds\": [{{photoFileId}}]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/photo/deletePhotos"
      },
      "response": []
    }
  ]
}
