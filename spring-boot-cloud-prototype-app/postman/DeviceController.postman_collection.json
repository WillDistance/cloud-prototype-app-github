{
  "info": {
    "_postman_id": "device-controller-collection",
    "name": "DeviceController",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8081/app"},
    {"key": "accessToken", "value": "[REDACTED]"}
  ],
  "item": [
    {
      "name": "getMyDevice",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
        "url": "{{baseUrl}}/api/device/getMyDevice"
      },
      "response": []
    },
    {
      "name": "bindDevice",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{accessToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"deviceId\": \"CC-2026-AB12-8A2F\",\n  \"password\": \"[REDACTED]\"\n}", "options": {"raw": {"language": "json"}}},
        "url": "{{baseUrl}}/api/device/bindDevice"
      },
      "response": []
    }
  ]
}
