<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.app.mapper.PaymentOrderMapper">

    <resultMap id="BaseResultMap" type="com.app.pojo.entity.PaymentOrderEntity">
        <result column="id" jdbcType="BIGINT" property="id"/>
        <result column="order_no" jdbcType="VARCHAR" property="orderNo"/>
        <result column="user_id" jdbcType="BIGINT" property="userId"/>
        <result column="storage_plan_id" jdbcType="BIGINT" property="storagePlanId"/>
        <result column="plan_code_snapshot" jdbcType="VARCHAR" property="planCodeSnapshot"/>
        <result column="plan_version_snapshot" jdbcType="INTEGER" property="planVersionSnapshot"/>
        <result column="plan_name_snapshot" jdbcType="VARCHAR" property="planNameSnapshot"/>
        <result column="capacity_bytes_snapshot" jdbcType="BIGINT" property="capacityBytesSnapshot"/>
        <result column="duration_value_snapshot" jdbcType="INTEGER" property="durationValueSnapshot"/>
        <result column="duration_unit_snapshot" jdbcType="VARCHAR" property="durationUnitSnapshot"/>
        <result column="amount_cent" jdbcType="BIGINT" property="amountCent"/>
        <result column="currency" jdbcType="VARCHAR" property="currency"/>
        <result column="payment_channel" jdbcType="VARCHAR" property="paymentChannel"/>
        <result column="provider_order_id" jdbcType="VARCHAR" property="providerOrderId"/>
        <result column="provider_capture_id" jdbcType="VARCHAR" property="providerCaptureId"/>
        <result column="payment_method" jdbcType="VARCHAR" property="paymentMethod"/>
        <result column="checkout_url" jdbcType="VARCHAR" property="checkoutUrl"/>
        <result column="status" jdbcType="VARCHAR" property="status"/>
        <result column="expire_time" jdbcType="TIMESTAMP" property="expireTime"/>
        <result column="paid_time" jdbcType="TIMESTAMP" property="paidTime"/>
        <result column="closed_time" jdbcType="TIMESTAMP" property="closedTime"/>
        <result column="client_request_id" jdbcType="VARCHAR" property="clientRequestId"/>
        <result column="create_by" jdbcType="VARCHAR" property="createBy"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_by" jdbcType="VARCHAR" property="updateBy"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, order_no, user_id, storage_plan_id, plan_code_snapshot, plan_version_snapshot, plan_name_snapshot, capacity_bytes_snapshot, duration_value_snapshot, duration_unit_snapshot, amount_cent, currency, payment_channel, provider_order_id, provider_capture_id, payment_method, checkout_url, status, expire_time, paid_time, closed_time, client_request_id, create_by, create_time, update_by, update_time
    </sql>

    <select id="selectByIdForUpdate" resultMap="BaseResultMap" parameterType="long">
        SELECT <include refid="Base_Column_List"/> FROM t_payment_order WHERE id = #{id} FOR UPDATE
    </select>

    <select id="selectByUserAndClientRequestId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM t_payment_order
        WHERE user_id = #{userId} AND client_request_id = #{clientRequestId}
        LIMIT 1
    </select>

    <select id="selectByUserAndOrderNo" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM t_payment_order
        WHERE user_id = #{userId} AND order_no = #{orderNo}
        LIMIT 1
    </select>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM t_payment_order
        WHERE order_no = #{orderNo}
        LIMIT 1
    </select>

    <select id="selectByProviderOrderId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM t_payment_order
        WHERE provider_order_id = #{providerOrderId}
        LIMIT 1
    </select>

    <update id="updateStatusById">
        UPDATE t_payment_order SET status = #{status}, update_time = CURRENT_TIMESTAMP(3) WHERE id = #{id} AND status = #{expectedStatus}
    </update>

    <update id="updateProviderOrder">
        UPDATE t_payment_order
        SET provider_order_id = #{providerOrderId}, checkout_url = #{checkoutUrl}, update_time = CURRENT_TIMESTAMP(3)
        WHERE id = #{id} AND status = 'PENDING'
    </update>

    <update id="updateProviderCapture">
        UPDATE t_payment_order
        SET provider_capture_id = #{providerCaptureId}, update_time = CURRENT_TIMESTAMP(3)
        WHERE id = #{id}
    </update>

    <update id="markPaid">
        UPDATE t_payment_order
        SET status = 'PAID', provider_capture_id = #{providerCaptureId},
            paid_time = #{paidTime}, update_time = CURRENT_TIMESTAMP(3)
        WHERE id = #{id} AND status = 'PENDING'
    </update>

</mapper>
