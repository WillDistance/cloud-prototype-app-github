<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.app.mapper.DeviceBindingMapper">

    <resultMap id="BaseResultMap" type="com.app.pojo.entity.DeviceBindingEntity">
        <result column="id" jdbcType="BIGINT" property="id"/>
        <result column="user_id" jdbcType="BIGINT" property="userId"/>
        <result column="device_id" jdbcType="BIGINT" property="deviceId"/>
        <result column="bind_time" jdbcType="TIMESTAMP" property="bindTime"/>
        <result column="bind_user_time_zone" jdbcType="VARCHAR" property="bindUserTimeZone"/>
        <result column="status" jdbcType="VARCHAR" property="status"/>
        <result column="create_by" jdbcType="VARCHAR" property="createBy"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_by" jdbcType="VARCHAR" property="updateBy"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, device_id, bind_time, bind_user_time_zone, status, create_by, create_time, update_by, update_time
    </sql>

    <select id="selectByIdForUpdate" resultMap="BaseResultMap" parameterType="long">
        SELECT <include refid="Base_Column_List"/> FROM t_device_binding WHERE id = #{id} FOR UPDATE
    </select>

    <update id="updateStatusById">
        UPDATE t_device_binding SET status = #{status}, update_time = CURRENT_TIMESTAMP(3) WHERE id = #{id} AND status = #{expectedStatus}
    </update>

</mapper>
