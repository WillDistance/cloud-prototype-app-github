<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.app.mapper.DeviceMapper">

    <resultMap id="BaseResultMap" type="com.app.pojo.entity.DeviceEntity">
        <result column="id" jdbcType="BIGINT" property="id"/>
        <result column="device_id" jdbcType="VARCHAR" property="deviceId"/>
        <result column="initial_password_hash" jdbcType="VARCHAR" property="initialPasswordHash"/>
        <result column="password_algorithm" jdbcType="VARCHAR" property="passwordAlgorithm"/>
        <result column="model" jdbcType="VARCHAR" property="model"/>
        <result column="status" jdbcType="VARCHAR" property="status"/>
        <result column="last_online_time" jdbcType="TIMESTAMP" property="lastOnlineTime"/>
        <result column="create_by" jdbcType="VARCHAR" property="createBy"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_by" jdbcType="VARCHAR" property="updateBy"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        ct.id, ct.device_id, ct.initial_password_hash, ct.password_algorithm, ct.model, ct.status, ct.last_online_time, ct.create_by, ct.create_time, ct.update_by, ct.update_time
    </sql>

    <select id="selectByBusinessDeviceId" resultMap="BaseResultMap">
        SELECT * FROM t_device WHERE device_id = #{deviceId} LIMIT 1
    </select>

    <select id="selectByDeviceIdForUpdate" resultMap="BaseResultMap">
        SELECT * FROM t_device WHERE device_id = #{deviceId} LIMIT 1 FOR UPDATE
    </select>

    <update id="markBoundIfUnbound">
        UPDATE t_device SET status = #{targetStatus}, update_time = UTC_TIMESTAMP(3) WHERE id = #{id} AND status = #{expectedStatus}
    </update>

</mapper>
