<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.app.mapper.PlatformConfigMapper">

    <resultMap id="BaseResultMap" type="com.app.pojo.entity.PlatformConfigEntity">
        <result column="id" jdbcType="BIGINT" property="id"/>
        <result column="config_version" jdbcType="VARCHAR" property="configVersion"/>
        <result column="max_file_size_bytes" jdbcType="BIGINT" property="maxFileSizeBytes"/>
        <result column="allowed_extensions" jdbcType="VARCHAR" property="allowedExtensions"/>
        <result column="device_gift_capacity_bytes" jdbcType="BIGINT" property="deviceGiftCapacityBytes"/>
        <result column="device_gift_duration_value" jdbcType="INTEGER" property="deviceGiftDurationValue"/>
        <result column="device_gift_duration_unit" jdbcType="VARCHAR" property="deviceGiftDurationUnit"/>
        <result column="status" jdbcType="VARCHAR" property="status"/>
        <result column="create_by" jdbcType="VARCHAR" property="createBy"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_by" jdbcType="VARCHAR" property="updateBy"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, config_version, max_file_size_bytes, allowed_extensions, device_gift_capacity_bytes, device_gift_duration_value, device_gift_duration_unit, status, create_by, create_time, update_by, update_time
    </sql>

    <select id="selectByIdForUpdate" resultMap="BaseResultMap" parameterType="long">
        SELECT <include refid="Base_Column_List"/> FROM t_platform_config WHERE id = #{id} FOR UPDATE
    </select>

    <update id="updateStatusById">
        UPDATE t_platform_config SET status = #{status}, update_time = CURRENT_TIMESTAMP(3) WHERE id = #{id} AND status = #{expectedStatus}
    </update>

</mapper>
