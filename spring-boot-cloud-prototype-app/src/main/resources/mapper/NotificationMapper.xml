<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.app.mapper.NotificationMapper">

    <resultMap id="BaseResultMap" type="com.app.pojo.entity.NotificationEntity">
        <result column="id" jdbcType="BIGINT" property="id"/>
        <result column="notification_no" jdbcType="VARCHAR" property="notificationNo"/>
        <result column="user_id" jdbcType="BIGINT" property="userId"/>
        <result column="notification_type" jdbcType="VARCHAR" property="notificationType"/>
        <result column="language_code" jdbcType="VARCHAR" property="languageCode"/>
        <result column="channel" jdbcType="VARCHAR" property="channel"/>
        <result column="recipient" jdbcType="VARCHAR" property="recipient"/>
        <result column="subject" jdbcType="VARCHAR" property="subject"/>
        <result column="content" jdbcType="VARCHAR" property="content"/>
        <result column="status" jdbcType="VARCHAR" property="status"/>
        <result column="retry_count" jdbcType="INTEGER" property="retryCount"/>
        <result column="next_retry_time" jdbcType="TIMESTAMP" property="nextRetryTime"/>
        <result column="sent_time" jdbcType="TIMESTAMP" property="sentTime"/>
        <result column="failure_reason" jdbcType="VARCHAR" property="failureReason"/>
        <result column="create_by" jdbcType="VARCHAR" property="createBy"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_by" jdbcType="VARCHAR" property="updateBy"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, notification_no, user_id, notification_type, language_code, channel, recipient, subject, content, status, retry_count, next_retry_time, sent_time, failure_reason, create_by, create_time, update_by, update_time
    </sql>

    <select id="selectByIdForUpdate" resultMap="BaseResultMap" parameterType="long">
        SELECT <include refid="Base_Column_List"/> FROM t_notification WHERE id = #{id} FOR UPDATE
    </select>

    <update id="updateStatusById">
        UPDATE t_notification SET status = #{status}, update_time = CURRENT_TIMESTAMP(3) WHERE id = #{id} AND status = #{expectedStatus}
    </update>

</mapper>
