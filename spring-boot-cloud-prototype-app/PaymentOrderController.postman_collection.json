{
  "info": {
    "name": "PaymentOrderController",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "createOrder",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{accessToken}}"},
          {"key": "Accept-Language", "value": "zh-CN"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"planCode\": \"{{planCode}}\",\n  \"planVersion\": {{planVersion}},\n  \"clientRequestId\": \"{{$guid}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/paymentOrder/createOrder",
          "host": ["{{baseUrl}}"],
          "path": ["api", "paymentOrder", "createOrder"]
        }
      }
    },
    {
      "name": "getOrder",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Authorization", "value": "Bearer {{accessToken}}"},
          {"key": "Accept-Language", "value": "zh-CN"}
        ],
        "url": {
          "raw": "{{baseUrl}}/api/paymentOrder/getOrder?orderNo={{orderNo}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "paymentOrder", "getOrder"],
          "query": [{"key": "orderNo", "value": "{{orderNo}}"}]
        }
      }
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8081/app"},
    {"key": "accessToken", "value": ""},
    {"key": "planCode", "value": "BASIC"},
    {"key": "planVersion", "value": "1"},
    {"key": "orderNo", "value": ""}
  ]
}
