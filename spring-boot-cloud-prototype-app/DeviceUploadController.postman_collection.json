{
  "info": {
    "_postman_id": "8c4f3ad2-a7c5-43a8-815c-d0a40a0d528d",
    "name": "DeviceUploadController",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8081/app"},
    {"key": "deviceId", "value": "CC-2026-AB12-8A2F"},
    {"key": "devicePassword", "value": "CAMERA123"},
    {"key": "uploadNo", "value": ""}
  ],
  "item": [
    {
      "name": "createUploadSession",
      "event": [{
        "listen": "test",
        "script": {"exec": ["const body = pm.response.json();", "if (body.data && body.data.uploadNo) pm.collectionVariables.set('uploadNo', body.data.uploadNo);"]}
      }],
      "request": {
        "method": "POST",
        "header": [
          {"key": "X-Device-Id", "value": "{{deviceId}}"},
          {"key": "X-Device-Password", "value": "{{devicePassword}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"originalFileName\": \"photo.jpg\",\n  \"contentType\": \"image/jpeg\",\n  \"fileSizeBytes\": 5242880\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": "{{baseUrl}}/api/deviceUpload/createUploadSession"
      },
      "response": []
    },
    {
      "name": "getUploadSessionStatus",
      "request": {
        "method": "GET",
        "header": [
          {"key": "X-Device-Id", "value": "{{deviceId}}"},
          {"key": "X-Device-Password", "value": "{{devicePassword}}"}
        ],
        "url": "{{baseUrl}}/api/deviceUpload/getUploadSessionStatus?uploadNo={{uploadNo}}"
      },
      "response": []
    }
  ]
}
